# Optional public canonical site URL once the production domain is confirmed.
# Leave unset until confirmed so unverified URLs are not advertised.
# Example: NEXT_PUBLIC_SITE_URL=https://waqas.dev
NEXT_PUBLIC_SITE_URL=

# Optional during local development: set to "true" to preview the exact
# strict public-only output (excluding draft projects and dev placeholders).
# In production builds (NODE_ENV=production), drafts are always excluded.
PORTFOLIO_STRICT_PUBLIC=

# ---------------------------------------------------------------------------
# Server-side Contact Delivery (POST /api/contact) — NEVER prefix with NEXT_PUBLIC_
# Configure EITHER Resend OR an HTTPS webhook endpoint in your hosting dashboard.
# ---------------------------------------------------------------------------
# Option A: Resend Email API (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Option B: Server-side HTTPS webhook (e.g., private notification endpoint)
CONTACT_WEBHOOK_URL=
